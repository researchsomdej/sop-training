  ['003', 'ข้อใด ไม่ใช่ การขัดแย้งทางผลประโยชน์ (Conflict of Interest)', ['เป็นที่ปรึกษาหรือเป็นผู้วิจัยในคณะวิจัย', 'ได้รับผลประโยชน์ทางการเงินจากโครงการวิจัยมูลค่า 2,500 บาท', 'ได้รับเงิน 3,500 บาทจากผู้สนับสนุนโครงการวิจัย', 'เป็นลูกจ้างของผู้สนับสนุนโครงการวิจัย', 'ได้รับลิขสิทธิ์ที่เป็นผลมาจากโครงการวิจัย']],
  ['003', 'การรักษาความลับด้านจริยธรรมการวิจัย ไม่รวมถึงข้อใดต่อไปนี้', ['ข้อมูลของคณะกรรมการจริยธรรมการวิจัย', 'ข้อมูลของโครงการวิจัย', 'ผลิตภัณฑ์ของผู้ให้ทุนวิจัย', 'ข้อมูลส่วนบุคคลของผู้เข้าร่วมการวิจัย', 'ข้อมูลของผู้ป่วยในเวชระเบียน']],
  ['004', 'คณะกรรมการจริยธรรมการวิจัยในมนุษย์จะต้องผ่านการฝึกอบรม ข้อใดบ้าง', ['Good Clinical Practice, Human Subject Protection', 'International Conference on Harmonization, Good Clinical Practice', 'International Review Board, ICH-GCP', 'Standard operation procedure, Human Subject Protection', 'International in Human Research, Good Clinical Practice']],
  ['005', 'ข้อใดเหมาะสมที่สุดในการคัดเลือกที่ปรึกษาอิสระ', ['ผู้วิจัยเสนอชื่ออาจารย์ที่ปรึกษาโครงการวิจัย', 'ประธานคณะกรรมการจริยธรรมการวิจัยเสนอชื่อแพทย์เฉพาะทาง', 'เลขาฯ เสนอชื่อผู้เชี่ยวชาญสาขาที่ตรงกับโครงการวิจัย', 'Sponsor เสนอชื่อแพทย์ผู้เชี่ยวชาญสาขาที่ตรงกับโครงการวิจัย', 'หัวหน้าฝ่ายการแพทย์เสนอชื่อผู้เชี่ยวชาญ']],
  ['006', 'ข้อใดไม่ถูกต้องเกี่ยวกับการบริหารจัดการโครงการวิจัยที่ยื่นขอรับการพิจารณา IRB', ['โครงการวิจัยที่มีความเสี่ยงน้อยมาก พิจารณาแบบยกเว้นการพิจารณา', 'โครงการวิจัยที่มีความเสี่ยงน้อยมากในกลุ่มเปราะบาง พิจารณาแบบเร็ว', 'โครงการวิจัยที่มีความเสี่ยงมากกว่าความเสี่ยงน้อย พิจารณาในที่ประชุมคณะกรรมการ', 'โครงการวิจัยที่มีความเสี่ยงน้อย พิจารณาแบบเร็ว', 'โครงการวิจัยที่ได้รับการรับรองจาก CREC แล้ว พิจารณาแบบยกเว้นการพิจารณา']],
  ['007', 'การทบทวนและประเมินโครงการวิจัย เริ่มต้นจากการประเมินข้อใด', ['ผู้วิจัยหลักและผู้วิจัยร่วม ควรมีคุณสมบัติเหมาะสม ในด้านการศึกษา การฝึกอบรมและประสบการณ์ที่จะดำเนินการวิจัยได้อย่างถูกต้อง', 'ผู้วิจัยหลักและผู้วิจัยร่วมจะต้องผ่านการอบรมการปฏิบัติการวิจัยทางคลินิกที่ดี (Good Clinical Practice: GCP) โดยส่งหลักฐานประกอบให้คณะกรรมการฯ', 'ผู้วิจัยหลักและผู้วิจัยร่วม ผู้ประสานงานโครงการวิจัย (ถ้ามี) จะต้องลงนามในเอกสารคำรับรองในการรักษาความลับ', 'ผู้วิจัยหลักและผู้วิจัยร่วม ที่ได้รับทุนสนับสนุนจากบริษัทเอกชนจะต้องแสดงงบประมาณการสนับสนุนทั้งด้านการเงิน', 'ทบทวนแบบยื่นขอรับการพิจารณาจริยธรรมการวิจัย ในเรื่องความครบถ้วน ถูกต้องของการกรอกแบบยื่นขอรับการพิจารณา IRB']],
  ['008', 'ข้อใดต่อไปนี้ สามารถยกเว้นการพิจารณาจริยธรรมการวิจัยได้', ['โครงการวิจัยที่ทบทวนข้อมูลในเวชระเบียน', 'โครงการวิจัยที่วิเคราะห์ข้อมูลการสำรวจสุขภาพจิตของเจ้าหน้าที่', 'โครงการวิจัยที่ทดลองในสัตว์ทดลอง', 'รายงานผู้ป่วยจำนวน 1-3 ราย', 'โครงการวิจัยที่พัฒนารูปแบบการรักษา']],
  ['010', 'ระยะเวลาเกินกำหนดของการพิจารณาโครงการวิจัยที่ส่งเข้ามาภายหลังการปรับปรุงแก้ไข คือ จำนวนกี่วันทำการ', ['100 วัน', '180 วัน', '90 วัน', '30 วัน', '90-180 วัน']],
  ['011', 'หากโครงการวิจัยมีขนาดกลุ่มตัวอย่างเดิม 15 คน และผู้วิจัยต้องการปรับเพิ่มจำนวนกลุ่มตัวอย่างอีก 5 คน (คิดเป็นร้อยละ 33.3) โดยไม่มีการขยายระยะเวลาโครงการ การขอแก้ไขปรับปรุงนี้จัดอยู่ในประเภทใด และต้องผ่านกระบวนการพิจารณาประเภทใด', ['Minor change - พิจารณาแบบ Expedited Review', 'Minor change - พิจารณาแบบ Full Board Review', 'Major change - พิจารณาแบบ Expedited Review', 'Major change - พิจารณาแบบ Full Board Review', 'ไม่จัดเป็น Protocol Amendment - ให้รายงานในแบบฟอร์มความก้าวหน้าประจำปี (AF12-01)']],
  ['011', 'ในกรณีที่สถานะการรับรองโครงการวิจัยหมดอายุลงก่อนที่ผู้วิจัยจะยื่นเรื่องขอแก้ไขเพิ่มเติมโครงการวิจัย (Protocol Amendment) สำนักงานคณะกรรมการ IRB จะดำเนินการอย่างไร', ['ดำเนินการพิจารณาต่อไปตามปกติแต่ชะลอการออกหนังสือรับรอง', 'ปรับระดับการพิจารณาจาก Minor Change เป็น Major Change โดยอัตโนมัติ', 'หยุดพักการพิจารณาส่วนแก้ไขเพิ่มเติมทันที จนกว่าผู้วิจัยจะทำเรื่องต่ออายุโครงการผ่านแบบฟอร์ม AF12-01 เรียบร้อย', 'ยกเลิกโครงการวิจัยทันทีและไม่อนุญาตให้ยื่นขอต่ออายุอีก', 'ส่งเรื่องให้ประธานคณะกรรมการ IRB พิจารณาตัดสินชี้ขาดภายใน 24 ชั่วโมง']],
  ['013', 'ตาม SOP 013.02 เจ้าหน้าที่สำนักงาน IRB มีหน้าที่ส่งหนังสือแจ้งเตือนอย่างเป็นทางการไปยังผู้วิจัยหลัก เพื่อให้เตรียมส่งรายงานสรุปผลการวิจัยฉบับสมบูรณ์ (AF13-01) ล่วงหน้าก่อนที่ใบรับรองโครงการจะหมดอายุเป็นเวลาเท่าใด', ['ล่วงหน้าอย่างน้อย 7 วัน', 'ล่วงหน้าอย่างน้อย 15 วัน', 'ล่วงหน้าอย่างน้อย 30 วัน', 'ล่วงหน้าอย่างน้อย 45 วัน', 'ล่วงหน้าอย่างน้อย 60 วัน']],
  ['013', 'ในขั้นตอนการพิจารณารายงานสรุปผลการวิจัยฉบับสมบูรณ์ (SOP 013.02 ขั้นตอนที่ 4) คณะกรรมการหรือผู้ได้รับการมอบหมายมีกรอบเวลา (Window) สำหรับการประเมินรายละเอียดทางจริยธรรมและวิทยาศาสตร์กี่วันทำการ', ['5 วันทำการ', '10 วันทำการ', '15 วันทำการ', '20 วันทำการ', '25 วันทำการ']],
  ['014', 'ขั้นตอนการจัดการรายงานการยุติโครงการวิจัยก่อนกำหนดหรือการระงับโครงการวิจัย ตาม SOP 014.02 กำหนดกรอบเวลารวมทั้งหมดตั้งแต่สำนักงานตรวจรับเอกสารจนถึงแจ้งผลเบ็ดเสร็จไว้กี่วันทำการ', ['10 วันทำการ', '15 วันทำการ', '20 วันทำการ', '25 วันทำการ', '30 วันทำการ']],
  ['014', 'ตาม SOP 014.02 การยื่นเอกสารรายงานการยุติโครงการก่อนกำหนดต้องยื่นในรูปแบบไฟล์ใด และมาตรการสำคัญที่สุดที่คณะกรรมการ IRB เพ่งเล็งตรวจตามแบบประเมิน AF14-01 คืออะไร', ['ไฟล์ DOCX - เน้นการเรียกคืนงบประมาณวิจัยที่เหลืออยู่', 'ไฟล์ PDF - เน้นแผนการติดตามรักษาดูแลอาสาสมัครและการแจ้งข้อมูลสถานการณ์ให้อาสาสมัครทราบอย่างตรงไปตรงมา', 'ไฟล์ PDF - เน้นการตีพิมพ์เผยแพร่ผลงานวิจัยส่วนที่เหลือทันที', 'ไฟล์ XLS - เน้นการทำลายข้อมูลและสิ่งส่งตรวจทางชีวภาพของอาสาสมัครทั้งหมด', 'ไฟล์ ZIP - เน้นการโอนย้ายอาสาสมัครไปยังโครงการวิจัยอื่นโดยไม่ต้องแจ้งรายละเอียด']],
  ['015', 'หากผู้วิจัยหลักตรวจพบการเบี่ยงเบนโครงการวิจัยระดับเมเจอร์ (Major Protocol Deviation) เช่น การให้ยาผิดขนาด หรือการปล่อยให้ข้อมูลความลับรั่วไหล ผู้วิจัยหลักมีหน้าที่ต้องรายงานต่อคณะกรรมการ IRB อย่างไร', ['รายงาน ภายใน 7 วัน นับจากวันที่ตรวจพบหรือรับทราบเหตุการณ์', 'รายงาน ภายใน 24 ชั่วโมงนับจากเกิดเหตุ', 'รายงาน ภายใน 10 วันทำการนับจากเกิดเหตุ', 'รายงาน พร้อมกับยื่นขอแก้ไขโครงการวิจัย', 'บันทึกไว้ในรายงานสรุปผลการวิจัยฉบับสมบูรณ์เมื่อเสร็จสิ้นโครงการ']],
  ['016', 'หากเกิดเหตุการณ์ไม่พึงประสงค์ร้ายแรง (SAE) ที่คุกคามต่อชีวิต หรือส่งผลให้เสียชีวิตขึ้นภายในสถาบันวิจัย ตาม SOP 016.02 ผู้วิจัยหลักต้องรายงานต่อคณะกรรมการ IRB ภายในกรอบเวลาใด', ['รายงาน ภายใน 24 ชั่วโมง', 'รายงาน ภายใน 5 วันทำการ', 'รายงาน ภายใน 7 วัน', 'รายงาน ภายใน 15 วัน', 'รายงาน ภายใน 30 วัน']],
  ['017', 'หากคณะกรรมการจริยธรรมการวิจัยได้รับข้อร้องเรียนจากผู้เข้าร่วมการวิจัยผ่านแบบฟอร์ม AF17-01 เกี่ยวกับประเด็นการขอความยินยอม (Informed Consent) ที่คลาดเคลื่อนไปจากโครงการวิจัย คณะกรรมการจะต้องจัดหมวดหมู่ปัญหา และปฏิบัติตามกรอบเวลาการแจ้งผลอย่างเป็นทางการไปยังผู้วิจัยหลัก ตามข้อใดจึงจะถูกต้องตาม SOP 017.02', ['จัดเป็นเรื่องไม่เกี่ยวกับงานวิจัย / แจ้งผลภายใน 3 วันทำการ', 'จัดเป็นเรื่องเกี่ยวกับการวิจัย / แจ้งผลภายใน 5 วันทำการ', 'จัดเป็นเรื่องเกี่ยวกับการวิจัย / แจ้งผลภายใน 7 วันนับจากวันรับเรื่อง', 'จัดเป็นเรื่องไม่เกี่ยวกับงานวิจัย / ส่งต่อองค์กรวิชาชีพ / แจ้งผลภายใน 10 วันทำการ', 'จัดเป็นเรื่องเกี่ยวกับการวิจัย / แจ้งผลภายใน 20 วันทำการ']],
  ['018', 'องค์ประกอบของคณะกรรมการตรวจเยี่ยมโครงการวิจัย จะต้องประกอบด้วยกรรมการจำนวนอย่างน้อยกี่ท่าน', ['อย่างน้อย 2 ท่าน', 'อย่างน้อย 3 ท่าน', 'อย่างน้อย 4 ท่าน', 'อย่างน้อย 5 ท่าน', 'ตามดุลพินิจของประธานกรรมการ']],
  ['019', 'เมื่อประธานกรรมการหรือเลขานุการพิจารณาประเมินความพร้อมของสถาบันแล้ว ประธานกรรมการจะต้องส่งแบบประเมินความพร้อมที่ลงนามแล้วกลับไปยังสำนักงานคณะกรรมการกลางฯ ภายในระยะเวลากี่วันทำการ', ['3 วันทำการ', '5 วันทำการ', '7 วันทำการ', '10 วันทำการ', '15 วันทำการ']],
  ['020', 'ข้อใด ไม่ใช่ ข้อกำหนดขององค์ประชุมในการประชุมคณะกรรมการจริยธรรมการวิจัยในมนุษย์', ['มีกรรมการทั้งชายและหญิงร่วมประชุม', 'มีกรรมการที่เป็นแพทย์ อย่างน้อย 3 คน', 'จำนวนกรรมการในที่ประชุมเกินกึ่งหนึ่งของจำนวนคณะกรรมการหลัก', 'มีกรรมการที่ไม่สังกัดโรงพยาบาลสมเด็จพระบรมราชเทวี ณ ศรีราชา อย่างน้อย 2 คน', 'มีกรรมการที่ไม่เกี่ยวข้องกับงานด้านการแพทย์ หรือวิทยาศาสตร์การแพทย์ อย่างน้อย 1 คน']],
  ['021', 'ระยะเวลาในการจัดเก็บเอกสารโครงการวิจัยแบบกระดาษภายหลังการรับทราบการแจ้งปิดหรือยุติโครงการวิจัยเสร็จสิ้นสมบูรณ์แล้ว คือข้อใด', ['1 ปี', '2 ปี', '3 ปี', '5 ปี', '10 ปี']],
  ['022', 'ขั้นตอนการปฏิบัติเมื่อพบข้อบกพร่องจากการตรวจเยี่ยม คือข้อใด', ['เก็บรายงานลงแฟ้มทันทีโดยไม่แก้ไข', 'ยกเลิกการรับรองและยื่นขอตรวจเยี่ยมใหม่', 'ให้ผู้บริหารสั่งการแก้ไขโดยไม่ผ่านที่ประชุม', 'ส่งรายงานให้หน่วยงานภายนอกพิจารณาเพิกถอนสิทธิ์', 'เสนอที่ประชุมทำแผนแก้ไข ส่งผู้ตรวจรับรอง และดำเนินการให้แล้วเสร็จ']]
];
